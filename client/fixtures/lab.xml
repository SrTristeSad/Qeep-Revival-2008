<?xml version="1.0" encoding="UTF-8"?>
<jcl base="/revival/" branding="Qeep Revival 2008">
  <form id="index" title="JCL - Laboratório">
    <p label="Página sintética para testes."/>
    <p label="Não recuperada do servidor Qeep."/>
    <hr/>
    <a id="more" label="Abrir outro formulário" href="#fields" focused="true"/>
    <button label="Sobre o protocolo" href="#about"/>
    <a label="Cores e separadores - laboratório" href="#styles" style="12"/>
    <a label="Formulário remoto - laboratório" href="/revival/page/submit"/>
    <a label="Tipos de selecao (JAR)" href="#choices"/>
    <lsk label="Voltar" href="#index"/>
    <rsk label="Abrir" href="#fields"/>
  </form>
  <form id="fields" title="Campos JCL">
    <input id="nickname" label="Nome de teste" len="30" value=""/>
    <textarea id="message" label="Mensagem" len="120">Olá!</textarea>
    <select id="choice" label="Escolha um item">
      <option label="Primeiro" value="1" selected="true"/>
      <option label="Segundo" value="2"/>
    </select>
    <gauge label="Progresso ilustrativo" value="35" max="100"/>
    <button label="Voltar ao índice" href="#index"/>
    <rsk label="Voltar" href="#index"/>
  </form>
  <form id="styles" title="Estilos verificados">
    <p label="Atributos de registry.ini; páginas e posições inventadas para teste." style="11"/>
    <p label="Amostra do estilo s1" style="1"/>
    <p label="Amostra do estilo s2" style="2"/>
    <p label="Amostra do estilo s7" style="7"/>
    <p label="Amostra do estilo s11" style="11"/>
    <li>Marcador de lista do interpretador original</li>
    <a href="#about"/>
    <p label="Imagens locais verificadas do JAR:"/>
    <img src="logo.png"/>
    <img src="icon_15x15.png"/>
    <hr w="90"/>
    <hr w="160"/>
    <button label="Voltar ao índice" href="#index"/>
    <lsk label="Início" href="#index"/>
    <rsk label="Sobre" href="#about"/>
  </form>
  <form id="choices" title="Seletor - bytecode s.class">
    <p label="Tipos confirmados no JAR; tela sintética de laboratório."/>
    <select id="radio" label="Escolha única" type="1">
      <option label="Roxo" value="purple" selected="true"/>
      <option label="Verde" value="green"/>
    </select>
    <select id="multi" label="Marque várias" type="2">
      <option label="Mensagens" value="chat" selected="true"/>
      <option label="Amigos" value="friends"/>
      <option label="Jogos" value="games"/>
    </select>
    <select id="compact" label="Compacta" type="4">
      <option label="Dia" value="day" selected="true"/>
      <option label="Noite" value="night"/>
    </select>
    <button label="Voltar" href="#index"/>
    <lsk label="Início" href="#index"/>
  </form>
  <form id="about" title="Referência">
    <p>Os tipos de componentes vêm do bytecode de h.class.</p>
    <p>Os textos e o layout desta página são exemplos criados para testes.</p>
    <a label="Retornar" href="#index"/>
  </form>
</jcl>

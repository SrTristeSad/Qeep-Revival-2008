<?xml version="1.0" encoding="UTF-8"?>
<jcl branding="Qeep Revival 2008">
  <form id="start" title="Composicao JCL">
    <p label="LABORATORIO - nao e uma tela historica" style="11"/>
    <p label="Esta pagina curta fica centralizada se houver espaco."/>
    <a label="Formulario alinhado ao topo" href="#top" focused="true"/>
    <a label="Formulario curto (centro)" href="#center"/>
    <a label="Lista longa para rolagem" href="#long"/>
    <lsk label="Sair" cancel="true"/>
    <rsk label="Abrir" cancel="false"/>
  </form>
  <form id="top" title="Valign top" valign="top">
    <p label="Alinhamento superior verificado em h.class."/>
    <button label="Retornar" href="#start"/>
